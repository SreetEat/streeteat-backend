# Copy this file to .env (same directory as docker-compose.yml, or repo root
# depending on how you invoke docker compose) and fill in real values before
# running `docker compose up`. Never commit the real .env file.

APP_NAME=streeteat-api
APP_PORT=8080
SPRING_PROFILE=prod

POSTGRES_DB=streeteat_db
POSTGRES_USER=streeteat
POSTGRES_PASSWORD=change-me-before-deploying
POSTGRES_PORT=5432

# HS256 requires at least 32 bytes (256 bits). Generate a real one with:
#   openssl rand -base64 48
# The application falls back to an insecure placeholder if this is unset --
# fine for local/dev, NOT fine for anything resembling production.
JWT_SECRET=change-me-to-a-real-random-secret-at-least-32-bytes-long
